PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://apepara:apepara@localhost:5432/apepara
# set DATABASE_SSL=true for managed Postgres that requires TLS
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# If no department of the right type covers the pin, fall back to the nearest one
# within this many km; otherwise the report is left unrouted for admin triage.
ROUTING_FALLBACK_KM=50
